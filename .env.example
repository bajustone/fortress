# Required by the Hono and Express examples. This is an exactly 32-byte,
# development-only AES key; replace it outside local development.
FORTRESS_TOTP_ENCRYPTION_KEY=test-only-totp-encryption-key!!!

# Optional. When omitted, the Hono example uses a development-only fallback.
# FORTRESS_SOCIAL_TOKEN_KEY=dev-social-token-key-32-bytes!!!

# Optional. Setting this enables the Hono example's one-time admin bootstrap route.
# FORTRESS_ADMIN_BOOTSTRAP_SECRET=replace-with-a-development-secret
