// src/plugins/api-key/scope-enforcement.test.ts
describe('api-key scope enforcement', () => {
  it('blocks RBAC actions outside the key scope', async () => {
    // Subject has report:delete; key is scoped to ['report:read'].
    const key = await apiKey.createKey({ subject, name: 'k', scopes: ['report:read'] });
    const res = await app.request('/reports/1', {
      method: 'DELETE',
      headers: { 'X-API-Key': key.key },
    });
    expect(res.status).toBe(403);
  });

  it('allows in-scope actions', async () => {
    const key = await apiKey.createKey({ subject, name: 'k', scopes: ['report:read'] });
    const res = await app.request('/reports/1', {
      headers: { 'X-API-Key': key.key },
    });
    expect(res.status).toBe(200);
  });

  it('unscoped keys inherit full subject permissions', async () => {
    const key = await apiKey.createKey({ subject, name: 'k' });
    const res = await app.request('/reports/1', {
      method: 'DELETE',
      headers: { 'X-API-Key': key.key },
    });
    expect(res.status).toBe(204);
  });
});
