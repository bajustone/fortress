## H1 — API-key scope enforcement

Three coordinated changes:

1. Thread `scopes` through the principal type.
2. Have the api-key plugin return them.
3. Intersect at the permission-check boundary.

```diff
--- a/src/core/http/principal.ts
+++ b/src/core/http/principal.ts
@@
 /** Result of a successful principal resolution. */
 export interface ResolvedPrincipal {
   subject: Subject;
   claims?: TokenClaims;
+  /**
+   * Optional scope list attached to the credential (api-key, oauth access
+   * token, etc). `null` or undefined = unscoped — the principal carries
+   * the subject's full IAM permissions. A non-empty array narrows the
+   * effective permission set to the intersection of the subject's grants
+   * and these scope strings (`*` / `resource:*` / `resource:action`).
+   */
+  scopes?: string[] | null;
 }
@@
 export async function tryPluginPrincipal(
   fortress: Fortress,
   request: Request,
 ): Promise<ResolvedPrincipal | null> {
   const plugins = fortress.config.plugins ?? [];
   for (const plugin of plugins) {
     if (!plugin.resolvePrincipal)
       continue;
     const resolved = await plugin.resolvePrincipal(request, {
       db: fortress.config.database,
       config: fortress.config,
       auth: fortress.auth,
       iam: fortress.iam,
     });
     if (resolved)
-      return { subject: resolved.subject, claims: resolved.claims };
+      return {
+        subject: resolved.subject,
+        claims: resolved.claims,
+        scopes: resolved.scopes ?? null,
+      };
   }
   return null;
 }
