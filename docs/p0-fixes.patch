## Tests to add

Three new spec files exercise the fixes end-to-end. Skeletons:

```ts
// src/core/auth/refresh-token.race.test.ts
describe('refresh rotation atomicity', () => {
  it('serializes concurrent refreshes — only one descendant is minted', async () => {
    const { auth } = await setup();
    const initial = await auth.login({ email: 'a@b.c', password: 'pw' });

    const results = await Promise.allSettled(
      Array.from({ length: 8 }, () => auth.refresh(initial.refreshToken)),
    );

    const wins = results.filter(r => r.status === 'fulfilled');
    const reuses = results.filter(r =>
      r.status === 'rejected' && (r as any).reason.code === 'token_reuse');

    expect(wins.length).toBe(1);
    expect(reuses.length).toBe(7);

    // Family is fully revoked after a reuse is detected on any sibling.
    const family = await db.findMany({ model: 'refresh_token', where: [...] });
    expect(family.every(t => t.isRevoked)).toBe(true);
  });
});
```

