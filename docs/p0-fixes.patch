```diff
--- /dev/null
+++ b/src/core/iam/scope.ts
@@
+/**
+ * Credential-scope intersection helper.
+ *
+ * API keys (and OAuth access tokens) can carry a `scopes` array that
+ * narrows the effective permission set of the credential to a subset of
+ * the owning subject's IAM grants. A scope string takes one of three
+ * shapes:
+ *
+ *   '*'                — wildcard, no narrowing
+ *   'resource:*'       — every action on a resource
+ *   'resource:action'  — exact (resource, action) pair
+ *
+ * `null` / `undefined` scopes mean the credential is unscoped and gets
+ * the subject's full grants. An empty array means "no permissions" —
+ * callers should treat that as an explicit deny.
+ */
+export function isWithinScope(
+  scopes: readonly string[] | null | undefined,
+  perm: { resource: string; action: string },
+): boolean {
+  if (scopes == null) return true;
+  if (scopes.length === 0) return false;
+  for (const s of scopes) {
+    if (s === '*') return true;
+    if (s === `${perm.resource}:*`) return true;
+    if (s === `${perm.resource}:${perm.action}`) return true;
+  }
+  return false;
+}
```

Wire the helper into the route-level RBAC check in
`src/core/http/fortress-rbac.ts` (the middleware that consumes the
endpoint's `.permission(...)` declaration):

```diff
--- a/src/core/http/fortress-rbac.ts
+++ b/src/core/http/fortress-rbac.ts
@@
+import { isWithinScope } from '../iam/scope';
@@
   // existing flow: required = endpoint.permission; principal = await resolveRequestPrincipal(...)
   if (required) {
+    // Credential-scope narrowing — applies before the IAM check. A scoped
+    // credential cannot reach a (resource, action) outside its scope set,
+    // regardless of what the owning subject is granted.
+    if (!isWithinScope(principal.scopes, required)) {
+      return forbidden('Credential scope does not include this permission');
+    }
     const allowed = await fortress.iam.checkPermission(
       principal.subject,
       required.resource,
       required.action,
     );
     if (!allowed) return forbidden('...');
   }
```

(Substitute the exact `forbidden()` / response helper your RBAC module
already uses — the audit only confirmed the broad shape; you'll see the
local helper in the file.)

