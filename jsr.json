{
  "name": "@bajustone/fortress",
  "version": "0.0.27",
  "license": "MIT",
  "description": "Framework-agnostic, adapter-based authentication and authorization library for TypeScript. Core auth (JWT, refresh tokens, password hashing) plus IAM (resource+action permissions, groups, roles) with a plugin system for OAuth, 2FA, tenancy, WebAuthn, magic links, audit logging, rate limiting, and more.",
  "runtimeCompat": {
    "node": true,
    "deno": true,
    "bun": true,
    "workerd": true,
    "browser": false
  },
  "publish": {
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/*.integration-test.ts",
      "vitest.config.ts",
      "vitest.integration.config.ts",
      "tsup.config.ts",
      "tsconfig.json",
      ".github",
      "examples",
      "docs",
      "scripts",
      "bin",
      ".claude",
      ".husky",
      "CLAUDE.md",
      "bun.lock",
      "eslint.config.js"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./crypto": "./src/core/auth/password.ts",
    "./jwt": "./src/core/auth/jwt.ts",
    "./otel": "./src/otel/index.ts",
    "./testing": "./src/testing/index.ts",
    "./drizzle": "./src/drizzle/index.ts",
    "./drizzle/pg": "./src/drizzle/pg/index.ts",
    "./hono": "./src/hono/index.ts",
    "./express": "./src/express/index.ts",
    "./sveltekit": "./src/sveltekit/index.ts",
    "./plugins/email-verification": "./src/plugins/email-verification/index.ts",
    "./plugins/api-key": "./src/plugins/api-key/index.ts",
    "./plugins/two-factor": "./src/plugins/two-factor/index.ts",
    "./plugins/social-login": "./src/plugins/social-login/index.ts",
    "./plugins/data-isolation": "./src/plugins/data-isolation/index.ts",
    "./plugins/tenancy": "./src/plugins/tenancy/index.ts",
    "./plugins/oauth": "./src/plugins/oauth/index.ts",
    "./plugins/rate-limit": "./src/plugins/rate-limit/index.ts",
    "./plugins/audit-log": "./src/plugins/audit-log/index.ts",
    "./plugins/account-lockout": "./src/plugins/account-lockout/index.ts",
    "./plugins/webauthn": "./src/plugins/webauthn/index.ts",
    "./plugins/magic-link": "./src/plugins/magic-link/index.ts",
    "./plugins/webhook": "./src/plugins/webhook/index.ts",
    "./plugins/openapi": "./src/plugins/openapi/index.ts",
    "./plugins/admin": "./src/plugins/admin/index.ts"
  }
}
