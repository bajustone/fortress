{
  "name": "@bajustone/fortress",
  "version": "0.2.2",
  "description": "Framework-agnostic, adapter-based authentication and authorization library for TypeScript. Core auth (JWT, refresh tokens, password hashing) plus IAM (resource+action permissions, groups, roles) with a plugin system for OAuth, 2FA, tenancy, WebAuthn, magic links, audit logging, rate limiting, and more.",
  "type": "module",
  "module": "src/index.ts",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "fortress": "./bin/fortress.ts"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./sveltekit": {
      "import": {
        "types": "./dist/sveltekit.d.ts",
        "default": "./dist/sveltekit.js"
      },
      "require": {
        "types": "./dist/sveltekit.d.cts",
        "default": "./dist/sveltekit.cjs"
      }
    },
    "./drizzle": {
      "import": {
        "types": "./dist/drizzle.d.ts",
        "default": "./dist/drizzle.js"
      },
      "require": {
        "types": "./dist/drizzle.d.cts",
        "default": "./dist/drizzle.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./crypto": {
      "import": {
        "types": "./dist/crypto.d.ts",
        "default": "./dist/crypto.js"
      },
      "require": {
        "types": "./dist/crypto.d.cts",
        "default": "./dist/crypto.cjs"
      }
    },
    "./jwt": {
      "import": {
        "types": "./dist/jwt.d.ts",
        "default": "./dist/jwt.js"
      },
      "require": {
        "types": "./dist/jwt.d.cts",
        "default": "./dist/jwt.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.ts",
        "default": "./dist/otel.js"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    }
  },
  "files": ["dist", "src", "docs", "examples", "migrations", "README.md", "LICENSE", "SECURITY.md", "CHANGELOG.md"],
  "scripts": {
    "dev": "bun run --watch examples/hono-app/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "version": "bun scripts/changelog.ts",
    "publish:dry": "npx jsr publish --dry-run --allow-dirty",
    "prepublishOnly": "tsup",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.2",
    "better-sqlite3": "^12.8.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.1.0",
    "hono": "^4.12.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postgres": "^3.4.9",
    "testcontainers": "^11.13.0",
    "tsup": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@sveltejs/kit": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.10",
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1",
    "hash-wasm": "^4.12.0",
    "jose": "^6.2.2"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  }
}
